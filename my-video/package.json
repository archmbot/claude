{
  "name": "my-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/tailwind-v4": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render DemoVideo out/demo.mp4",
    "render:ad": "remotion render QylineAd out/qyline-pub-20s.mp4",
    "still": "remotion still DemoVideo out/thumbnail.png --frame=60",
    "audio": "node scripts/make-audio.mjs",
    "render:ad-mobile": "remotion render QylineAdVertical out/qyline-pub-mobile.mp4",
    "bu15:audio": "node scripts/black-u15/make-audio.mjs",
    "bu15:render": "remotion render BlackU15Intro out/black-u15-intro-4k.mp4 --scale=2 --crf=20",
    "legal:voice": "python3 scripts/qyline-legal/make-voice.py .kokoro",
    "legal:audio": "node scripts/qyline-legal/make-audio.mjs",
    "legal:render": "remotion render QylineLegal out/qyline-mentions-legales.mp4",
    "choix:voice": "python3 scripts/qyline-choix/make-voice.py .kokoro",
    "choix:audio": "node scripts/qyline-choix/make-audio.mjs",
    "choix:render": "remotion render QylineChoix out/qyline-site-vitrine-ou-boutique.mp4 --codec=h264 --crf=18",
    "reseau:voice": "python3 scripts/reseau-1-1/make-voice.py .kokoro",
    "reseau:audio": "python3 scripts/reseau-1-1/make-audio.py",
    "reseau:render": "remotion render Reseau11 out/reseau-1-1-quest-ce-quun-reseau.mp4 --codec=h264 --crf=20",
    "nas:voice": "python3 scripts/nas-cout/make-voice.py .kokoro",
    "nas:audio": "node scripts/nas-cout/make-audio.mjs",
    "nas:render": "remotion render NasCout out/nas-devis-pourquoi-informatique-si-cher.mp4 --codec=h264 --crf=18",
    "stokara:voice": "python3 scripts/stokara/make-voice.py .piper",
    "stokara:audio": "node scripts/stokara/make-audio.mjs",
    "stokara:render": "remotion render StokaraTuto out/stokara-tutoriel-guide-complet.mp4 --codec=h264 --crf=20",
    "pub:voice": "python3 scripts/stokara-pub/make-voice.py .piper",
    "pub:audio": "node scripts/stokara-pub/make-audio.mjs",
    "pub:render": "remotion render StokaraPub out/stokara-pub-30s-9x16.mp4 --codec=h264 --crf=18"
  },
  "sideEffects": [
    "*.css"
  ]
}
